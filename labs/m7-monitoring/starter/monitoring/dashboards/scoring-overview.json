{
  "uid": "scoring-overview",
  "title": "scoring-overview",
  "description": "Service de scoring (Lab 7) : SLO, modèle, drift, infra, logs.",
  "tags": [
    "scoring",
    "mlops",
    "lab7"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "custom",
        "query": "scoring,scoring-staging",
        "current": {
          "text": "scoring",
          "value": "scoring"
        },
        "options": [
          {
            "text": "scoring",
            "value": "scoring",
            "selected": true
          },
          {
            "text": "scoring-staging",
            "value": "scoring-staging",
            "selected": false
          }
        ]
      },
      {
        "name": "revision",
        "label": "Révision",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ml_model_info{namespace=\"$namespace\"}, revision)",
        "definition": "label_values(ml_model_info{namespace=\"$namespace\"}, revision)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "SLO — ce que ressent l'utilisateur",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Requêtes /predict par seconde",
      "description": "Trafic de l'API (toutes révisions sélectionnées).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",handler=\"/predict\"}[1m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "RPS par révision",
      "description": "Pendant un canary : la répartition du trafic entre révisions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (revision) (rate(http_requests_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",handler=\"/predict\"}[1m]))",
          "legendFormat": "{{revision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Latence P95 / P99",
      "description": "SLO : P95 < 200 ms (alerte ScoringHighLatency).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ml_inference_latency_seconds_bucket{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[5m]))) * 1000",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ml_inference_latency_seconds_bucket{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[5m]))) * 1000",
          "legendFormat": "P99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Taux de succès (non-5xx)",
      "description": "SLO de disponibilité : 99,5 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(rate(http_requests_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",handler=\"/predict\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",handler=\"/predict\"}[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 6,
      "title": "Modèle — ce que dit le modèle",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Décisions par seconde (outcome 1 = classe positive : refus)",
      "description": "Empilé : volume total et part de chaque décision.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(ml_predictions_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[1m]))",
          "legendFormat": "outcome {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Taux de décisions positives par révision",
      "description": "Alerte ScoringPositiveRateShift si l'écart aux 6 h dépasse 10 points.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (revision) (rate(ml_predictions_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",outcome=\"1\"}[5m])) / sum by (revision) (rate(ml_predictions_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[5m]))",
          "legendFormat": "{{revision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "heatmap",
      "id": 9,
      "title": "Distribution des scores (probabilité de la classe positive)",
      "description": "Un glissement de la masse vers la droite = plus de demandes jugées risquées.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(ml_prediction_score_bucket{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[1m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        }
      }
    },
    {
      "type": "gauge",
      "id": 10,
      "title": "Score médian",
      "description": "Médiane du score servi sur 5 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ml_prediction_score_bucket{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "bargauge",
      "id": 11,
      "title": "Taux de décisions positives par groupe sensible (15 min)",
      "description": "Groupes de dataset.yaml (sensitive) : écarts à analyser avec le Lab 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (attribute, group) (rate(ml_predictions_by_group_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\",outcome=\"1\"}[15m])) / sum by (attribute, group) (rate(ml_predictions_by_group_total{namespace=\"$namespace\",isvc=\"scoring-model\",revision=~\"$revision\"}[15m]))",
          "legendFormat": "{{attribute}} = {{group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "type": "table",
      "id": 12,
      "title": "Versions servies",
      "description": "Une ligne par révision Knative (deux pendant un canary).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (revision, model_version, api_version, threshold) (ml_model_info{namespace=\"$namespace\",isvc=\"scoring-model\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 13,
      "title": "Drift — Evidently (CronJob toutes les 15 min)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "id": 14,
      "title": "Score de drift par variable (PSI)",
      "description": "PSI < 0,1 stable · 0,1-0,25 à surveiller · > 0,25 dérive (alerte).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature) (ml_drift_score{model=\"scoring-model\"})",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "id": 15,
      "title": "Variables en dérive",
      "description": "Nombre de variables au-dessus du seuil au dernier run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ml_drift_detected{model=\"scoring-model\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 16,
      "title": "Demandes analysées (dernier run)",
      "description": "Sous MIN_ROWS (500), le drift n'est pas calculé.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ml_drift_current_rows{model=\"scoring-model\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 17,
      "title": "Dernier run du job de drift",
      "description": "Alerte ScoringDriftJobStale au-delà de 45 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 20,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(push_time_seconds{job=\"scoring-drift\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1200
              },
              {
                "color": "red",
                "value": 2700
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 18,
      "title": "Infra — la machinerie",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "CPU par pod",
      "description": "Conteneur de l'API (hors queue-proxy de Knative).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"scoring-model-predictor-.*\",container=\"kserve-container\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Mémoire par pod",
      "description": "Limite : 512 Mi (Lab 5).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"scoring-model-predictor-.*\",container=\"kserve-container\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Pods scrapés par révision",
      "description": "Cibles du PodMonitor en état UP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (revision) (up{namespace=\"$namespace\",isvc=\"scoring-model\"})",
          "legendFormat": "{{revision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 22,
      "title": "Logs — Loki",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "type": "logs",
      "id": 23,
      "title": "Logs de l'API (Loki)",
      "description": "Prédictions journalisées en JSON + logs d'accès d'uvicorn.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"$namespace\", container=\"kserve-container\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
