# =============================================================================
# Versions de référence du cours MLOps — source unique de vérité.
# Tous les scripts (Makefile, infra/*/install.sh, CI) lisent ce fichier.
# Mettre à jour une version = modifier UNE ligne ici puis laisser la CI
# (workflow course-e2e) valider l'ensemble sur un cluster kind.
# Dernière revue : octobre 2026.
# =============================================================================

# --- Python -------------------------------------------------------------------
PYTHON_VERSION=3.12

# --- Cluster local ------------------------------------------------------------
KIND_VERSION=v0.33.0
KIND_CLUSTER_NAME=mlops-lab
# Image de nœud par défaut de kind v0.33.0 (Kubernetes v1.37.0) — utilisée par make prefetch
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
REGISTRY_NAME=kind-registry
REGISTRY_PORT=5001
REGISTRY_IMAGE=registry:3

# --- Stockage objet S3 (remplace MinIO, archivé en 2026) ----------------------
SEAWEEDFS_IMAGE=ghcr.io/chrislusf/seaweedfs:4.48
S3_ENDPOINT_LOCAL=http://localhost:8333
S3_ENDPOINT_CLUSTER=http://s3.storage:8333
AWS_CLI_IMAGE=amazon/aws-cli:2.37.9

# --- Tracking / registry ------------------------------------------------------
MLFLOW_VERSION=3.16.1
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.1

# --- Orchestration --------------------------------------------------------------
KFP_VERSION=2.17.2
KFP_SDK_VERSION=2.17.0
AIRFLOW_VERSION=3.3.2

# --- Serving ------------------------------------------------------------------
CERT_MANAGER_VERSION=v1.21.2
KNATIVE_VERSION=knative-v1.23.0
KSERVE_VERSION=v0.21.0
KEDA_VERSION=v2.21.0
METRICS_SERVER_VERSION=v0.9.0

# --- CI/CD / GitOps -----------------------------------------------------------
ARGOCD_VERSION=v3.5.3
# Argo Rollouts n'est plus utilisé par les labs (canary KServe piloté par Git) :
# conservé pour une extension éventuelle sur des Deployments classiques.
ARGO_ROLLOUTS_VERSION=v1.10.0

# --- Observabilité ------------------------------------------------------------
KUBE_PROMETHEUS_STACK_VERSION=91.9.0
PUSHGATEWAY_CHART_VERSION=3.9.0
LOKI_CHART_VERSION=18.13.8
ALLOY_CHART_VERSION=1.13.0

# --- Sécurité / gouvernance ---------------------------------------------------
TRIVY_VERSION=v0.75.0
EXTERNAL_SECRETS_VERSION=v2.11.0

# --- LLMOps -------------------------------------------------------------------
OLLAMA_VERSION=v0.35.1
QDRANT_VERSION=v1.19.2
